<% content_for :title, "Reset your password — Wrap My Cover" %>
<section class="mx-auto max-w-md px-5 py-20">
  <h1 class="text-3xl font-semibold tracking-tight">Reset your password</h1>
  <p class="mt-2 text-sm text-parchment-700">We'll email you a reset link.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= invisible_captcha %>
    <div>
      <%= f.label :email, class: "block text-sm font-semibold" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
    </div>
    <%= f.submit "Send reset link", class: "w-full cursor-pointer rounded-xl bg-oxblood-700 px-5 py-3 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
