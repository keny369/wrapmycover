<% content_for :title, "Sign in — Wrap My Cover" %>
<% content_for :description, "Sign in to Wrap My Cover to build print-ready Amazon KDP paperback and hardcover covers from the ebook cover you already have." %>
<section class="mx-auto max-w-md px-5 py-20">
  <h1 class="text-3xl font-semibold tracking-tight">Sign in</h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-semibold" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-semibold" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
    </div>
    <%= f.submit "Sign in", class: "w-full cursor-pointer rounded-xl bg-oxblood-700 px-5 py-3 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
