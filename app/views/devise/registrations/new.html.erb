<% content_for :title, "Create your free account — Wrap My Cover" %>
<% content_for :description, "Create a free Wrap My Cover account and turn your ebook cover into a print-ready KDP paperback or hardcover cover in minutes." %>
<section class="mx-auto max-w-md px-5 py-20">
  <h1 class="text-3xl font-semibold tracking-tight">Create your free account</h1>
  <p class="mt-2 text-sm text-parchment-700">Free to design and preview &mdash; no card needed now. Exporting costs $14.99 per book, once.</p>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= invisible_captcha %>
    <div>
      <%= f.label :email, class: "block text-sm font-semibold" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-semibold" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 12,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
      <p class="mt-1 text-xs text-parchment-700">At least 12 characters.</p>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-semibold" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "mt-1.5 w-full rounded-xl border border-parchment-300 bg-white px-4 py-3 text-sm focus:border-oxblood-600 focus:outline-none" %>
    </div>
    <%= f.submit "Create account", class: "w-full cursor-pointer rounded-xl bg-oxblood-700 px-5 py-3 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
