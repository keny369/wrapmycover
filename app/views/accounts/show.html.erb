<% content_for :title, "Your account — Wrap My Cover" %>

<section class="mx-auto max-w-4xl px-5 py-14">
  <h1 class="text-3xl font-semibold tracking-tight">Your account</h1>
  <p class="mt-1 text-sm text-parchment-700"><%= current_user.email %></p>

  <!-- The editor -->
  <div class="mt-10 rounded-2xl border-2 border-oxblood-600 bg-parchment-50 p-6">
    <div class="flex flex-wrap items-center gap-4">
      <div>
        <h2 class="font-semibold">Start a cover</h2>
        <p class="mt-1 text-sm text-parchment-700">Upload your front cover, set the book&rsquo;s details, and preview the full wrap in the editor.</p>
      </div>
      <div class="ml-auto">
        <%= link_to "Open the editor", editor_url,
              class: "rounded-xl bg-oxblood-700 px-4 py-2.5 text-sm font-semibold text-parchment-50 hover:bg-oxblood-600" %>
      </div>
    </div>
  </div>

  <!-- Subscription -->
  <div class="mt-10 rounded-2xl border border-parchment-200 bg-parchment-50 p-6">
    <div class="flex flex-wrap items-center gap-4">
      <div>
        <h2 class="font-semibold">Pro subscription</h2>
        <p class="mt-1 text-sm text-parchment-700">
          <% if current_user.pro? %>
            Active<%= @subscription.current_period_end ? " · renews #{@subscription.current_period_end.to_date}" : "" %>
          <% elsif @subscription %>
            Status: <%= @subscription.status %>
          <% else %>
            Not subscribed — books are unlocked individually.
          <% end %>
        </p>
      </div>
      <div class="ml-auto flex gap-3">
        <% if @subscription&.stripe_customer_id.present? %>
          <%= button_to "Manage billing", billing_portal_path, method: :post,
                class: "cursor-pointer rounded-xl border border-parchment-300 px-4 py-2.5 text-sm font-semibold hover:bg-parchment-100" %>
        <% else %>
          <%= link_to "See pricing", pricing_path,
                class: "rounded-xl bg-oxblood-700 px-4 py-2.5 text-sm font-semibold text-parchment-50 hover:bg-oxblood-600" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Books -->
  <div class="mt-6 rounded-2xl border border-parchment-200 bg-parchment-50 p-6">
    <h2 class="font-semibold">Your books</h2>
    <% if @purchases.any? %>
      <ul class="mt-4 divide-y divide-parchment-200">
        <% @purchases.each do |purchase| %>
          <li class="flex items-center gap-4 py-3">
            <span class="font-medium"><%= purchase.book_title %></span>
            <% if purchase.status == "paid" %>
              <span class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">Unlocked</span>
            <% else %>
              <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800"><%= purchase.status.capitalize %></span>
            <% end %>
            <span class="ml-auto text-sm text-parchment-700"><%= purchase.created_at.to_date %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-parchment-700">No purchases yet. Design free, pay when you export.</p>
    <% end %>
  </div>

  <!-- Sessions -->
  <div class="mt-6 rounded-2xl border border-parchment-200 bg-parchment-50 p-6">
    <h2 class="font-semibold">Signed-in devices</h2>
    <p class="mt-1 text-sm text-parchment-700">Up to <%= User::MAX_ACTIVE_SESSIONS %> devices can be signed in at once; the oldest is signed out automatically.</p>
    <ul class="mt-4 divide-y divide-parchment-200">
      <% @active_sessions.each do |active_session| %>
        <li class="flex items-center gap-4 py-3 text-sm">
          <div>
            <p class="font-medium"><%= active_session.ip %><%= " · this device" if active_session.token_digest == @current_session_token_digest %></p>
            <p class="text-parchment-700">Last seen <%= time_ago_in_words(active_session.last_seen_at || active_session.created_at) %> ago</p>
          </div>
          <% unless active_session.token_digest == @current_session_token_digest %>
            <%= button_to "Sign out", active_session_path(active_session), method: :delete,
                  class: "ml-auto cursor-pointer rounded-lg border border-parchment-300 px-3 py-1.5 text-xs font-semibold hover:bg-parchment-100" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
