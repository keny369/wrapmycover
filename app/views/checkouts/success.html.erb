<% content_for :title, "Payment received — Wrap My Cover" %>

<section class="mx-auto max-w-xl px-5 py-24 text-center">
  <% if @purchase&.status == "paid" %>
    <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-green-600 text-2xl text-white">&check;</div>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight">You&rsquo;re unlocked</h1>
    <p class="mt-3 text-parchment-700">
      <strong><%= @purchase.book_title %></strong> can now export print-ready PDFs and eBook covers, forever.
    </p>
  <% else %>
    <div class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-amber-500 text-2xl text-white">&hellip;</div>
    <h1 class="mt-6 text-3xl font-semibold tracking-tight">Confirming your payment</h1>
    <p class="mt-3 text-parchment-700">
      Stripe has your payment; we&rsquo;re waiting for confirmation (usually seconds).
      <%= link_to "Refresh", url_for(session_id: params[:session_id]), class: "font-semibold text-oxblood-700 underline" %>
    </p>
  <% end %>
  <div class="mt-8">
    <%= link_to "Go to your account", account_path, class: "rounded-xl bg-oxblood-700 px-6 py-3 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
  </div>
</section>
