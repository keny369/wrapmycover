<% content_for :title, "Checkout cancelled — Wrap My Cover" %>

<section class="mx-auto max-w-xl px-5 py-24 text-center">
  <h1 class="text-3xl font-semibold tracking-tight">Checkout cancelled</h1>
  <p class="mt-3 text-parchment-700">No charge was made. Your work is exactly where you left it.</p>
  <div class="mt-8 flex justify-center gap-3">
    <%= link_to "Back to pricing", pricing_path, class: "rounded-xl bg-oxblood-700 px-6 py-3 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
    <%= link_to "Home", root_path, class: "rounded-xl border border-parchment-300 px-6 py-3 font-semibold hover:bg-parchment-100" %>
  </div>
</section>
