<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <%
      page_title = content_for(:title).presence || "Wrap My Cover — ebook covers to print-ready KDP covers"
      page_desc  = content_for(:description).presence || "Turn your ebook cover into a print-ready paperback or hardcover cover. Wrap My Cover builds the spine, back and bleed, then exports a 300 DPI KDP PDF."
      og_image   = "https://#{ApplicationController::CANONICAL_HOST || request.host}/og-image.png"
    %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_desc %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Open Graph + Twitter %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Wrap My Cover">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_desc %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_desc %>">
    <meta name="twitter:image" content="<%= og_image %>">

    <%# Structured data %>
    <% canonical_root = "https://#{ApplicationController::CANONICAL_HOST || request.host}" %>
    <script type="application/ld+json" nonce="<%= content_security_policy_nonce %>">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Wrap My Cover",
          "url": "<%= canonical_root %>",
          "logo": "<%= canonical_root %>/icon.png",
          "description": "The ebook-to-print cover converter. Turns an ebook cover into a print-ready Amazon KDP paperback or hardcover cover."
        },
        {
          "@type": "WebSite",
          "name": "Wrap My Cover",
          "url": "<%= canonical_root %>"
        }
      ]
    }
    </script>

    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-parchment-50 font-display text-parchment-900 antialiased">
    <header class="border-b border-parchment-200 bg-parchment-50/90 backdrop-blur sticky top-0 z-40">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
        <%# Brand lockup: the name never appears without its descriptor at launch. %>
        <%= link_to root_path, class: "flex items-center gap-2.5", "aria-label": "Wrap My Cover — the ebook-to-print cover converter" do %>
          <svg viewBox="0 0 48 48" class="h-9 w-9 flex-none" aria-hidden="true">
            <ellipse cx="26" cy="28" rx="16" ry="5.8" fill="none" stroke="#c9920e" stroke-width="3.2"></ellipse>
            <rect x="15.6" y="11.8" width="4.4" height="23.6" rx="1.5" fill="#e7dcc8"></rect>
            <rect x="18.8" y="10.2" width="15.2" height="27" rx="2.7" fill="#5e1f1c"></rect>
            <path d="M42 28 A16 5.8 0 0 1 12.6 30.2" fill="none" stroke="#c9920e" stroke-width="3.2" stroke-linecap="round"></path>
            <path d="M7.6 23.8 L15.2 24.6 L12.2 31.6 Z" fill="#c9920e"></path>
          </svg>
          <span class="flex flex-col leading-none">
            <span class="text-[15px] font-semibold tracking-tight">Wrap My Cover</span>
            <span class="mt-0.5 hidden text-[10px] font-medium uppercase tracking-[0.12em] text-parchment-600 sm:block">The ebook-to-print cover converter</span>
          </span>
        <% end %>
        <div class="ml-auto flex items-center gap-5 text-sm">
          <%= link_to "Pricing", pricing_path, class: "text-parchment-700 hover:text-parchment-900" %>
          <% if user_signed_in? %>
            <%= link_to "Account", account_path, class: "text-parchment-700 hover:text-parchment-900" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "rounded-lg border border-parchment-200 px-3.5 py-2 font-semibold text-parchment-700 hover:bg-parchment-100 cursor-pointer" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-parchment-700 hover:text-parchment-900" %>
            <%= link_to "Start free", new_user_registration_path,
                  class: "rounded-lg bg-oxblood-700 px-4 py-2 font-semibold text-parchment-50 hover:bg-oxblood-600" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% if notice.present? %>
      <div class="mx-auto mt-4 max-w-6xl px-5">
        <p class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" role="status"><%= notice %></p>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto mt-4 max-w-6xl px-5">
        <p class="rounded-lg border border-oxblood-200 bg-oxblood-50 px-4 py-3 text-sm text-oxblood-800" role="alert"><%= alert %></p>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="mt-24 border-t border-parchment-200 py-10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-4 gap-y-2 px-5 text-sm text-parchment-700">
        <span class="font-semibold text-parchment-900">Wrap My Cover.</span>
        <span>The ebook-to-print cover converter.</span>
        <span class="ml-auto">Wrap My Cover is not affiliated with Amazon. Amazon, Kindle and KDP are trademarks of Amazon.com, Inc.</span>
      </div>
    </footer>
  </body>
</html>
